{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --build && vite build",
		"preview": "vite preview",
		"test:unit": "vitest run --environment jsdom",
		"test:e2e": "playwright test",
